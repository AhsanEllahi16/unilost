rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMatchCountOnlyUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['matchCount']);
    }

    function isMarkingRegistered() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRegistered'])
        && request.resource.data.isRegistered == true;
    }

    function isFinderConfirmingDropOff() {
      return isSignedIn()
        && resource.data.postedByUid == request.auth.uid
        && resource.data.custody == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['dropOffConfirmedByFinder'])
        && request.resource.data.dropOffConfirmedByFinder == true;
    }

    function isAdminReceivingDropOff() {
      return isSignedIn()
        && resource.data.custody == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['dropOffReceivedByAdmin'])
        && request.resource.data.dropOffReceivedByAdmin == true;
    }

    match /valid_students/{rollNumber} {
      allow read: if true;
      allow update: if isMarkingRegistered();
      allow create, delete: if false;
    }

    match /roll_lookup/{rollNumber} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isMatchCountOnlyUpdate();
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.postedByUid == request.auth.uid;
      allow update: if isSignedIn()
                    && (resource.data.postedByUid == request.auth.uid
                        || isFinderConfirmingDropOff()
                        || isAdminReceivingDropOff());
      allow delete: if isSignedIn()
                    && resource.data.postedByUid == request.auth.uid;
    }

    match /post_secrets/{postId} {
      allow read: if isSignedIn() &&
        (get(/databases/$(database)/documents/posts/$(postId)).data.postedByUid == request.auth.uid ||
         exists(/databases/$(database)/documents/verifications/$(postId + '_' + request.auth.uid)));
      allow create, update: if isSignedIn() &&
        get(/databases/$(database)/documents/posts/$(postId)).data.postedByUid == request.auth.uid;
      allow delete: if false;
    }

    // verifications/{postId_claimantUid} — one active verification
    // record per claimant per found post. The read rule explicitly
    // allows checking a verification that doesn't exist yet
    // (resource == null) — the app's "does a claim already exist"
    // check runs BEFORE any document is created, so resource is null
    // on that very first read, and referencing resource.data without
    // this guard causes an evaluation error (treated as deny).
    match /verifications/{verificationId} {
      allow read: if isSignedIn() &&
        (resource == null ||
         resource.data.claimantUid == request.auth.uid ||
         resource.data.finderUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.claimantUid == request.auth.uid &&
        verificationId == (request.resource.data.foundPostId + '_' + request.auth.uid);
      allow update: if isSignedIn() &&
        (resource.data.claimantUid == request.auth.uid ||
         resource.data.finderUid == request.auth.uid);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn()
                  && (resource.data.lostUserUid == request.auth.uid
                      || resource.data.foundUserUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn()
                  && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
                  && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isSignedIn()
                  && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    match /notifications/{uid}/items/{itemId} {
      allow read, update, delete: if isOwner(uid);
      allow create: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}